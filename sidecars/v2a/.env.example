# OpenZigs v2a sidecar — environment template.
# Copy to `.env` and edit. All variables are optional; defaults are shown.

# Listen port (default 5012).
PORT=5012

# HuggingFace model id. Override only if you've forked or vendored MMAudio.
V2A_MODEL=hkchengrex/MMAudio

# Default and maximum audio clip duration (seconds).
V2A_DEFAULT_DURATION=8.0
V2A_MAX_DURATION=30.0

# Idle timeout (seconds) before the pipeline is unloaded to free VRAM.
V2A_IDLE_TIMEOUT=300

# Bearer token clients must present in `Authorization: Bearer <token>`.
# Leave empty to disable auth (loopback-only deploys).
WORKER_SECRET_TOKEN=

# LTX Worker Environment Configuration Template
# Copy this file to .env in ~/ltx-worker/ and fill in your values.
# NOTE: .env is not committed to git — it contains secrets.

# ===== CORE =====
LTX_SECRET_TOKEN=your-secret-token-here
M2_PRO_HOST=0.0.0.0
M2_PRO_PORT=5007
LTX_MODEL_REPO=AITRADER/ltx2-distilled-4bit-mlx

# Flush stdout so prints survive a crash
PYTHONUNBUFFERED=1

# ===== QUANTIZATION =====
# CRITICAL: DO NOT set LTX_USE_PREQUANT=1 — AITRADER pre-quantized snapshots
# produce "snow"/garbled video output.
# The CharafChnioune/mlx-video fork (required) auto-detects AITRADER repos and
# uses runtime quantization from the BF16 base model (mlx-community/LTX-2-distilled-bf16)
# instead. This produces clean video.
#
# If you see garbled/snow video, check that LTX_USE_PREQUANT is NOT set.
# LTX_USE_PREQUANT=1  ← LEAVE THIS COMMENTED OUT

# ===== METAL GPU WATCHDOG WORKAROUNDS (M2 Pro / macOS 26 Tahoe) =====

# CRITICAL: macOS 26 Tahoe Metal GPU watchdog workaround.
# Disables the AGX interactivity timeout that kills long-running Metal command
# buffers when WindowServer needs GPU time for display compositing.
# See: https://github.com/ml-explore/mlx/issues/3267
# See: https://github.com/ml-explore/mlx/issues/3302
AGX_RELAX_CDM_CTXSTORE_TIMEOUT=1

# Disable lazy compilation during model load to prevent Metal command buffer
# explosions from deferred kernel compilation.
MLX_DISABLE_COMPILE=1

# Official MLX workaround for GPU kernel timeout on M2 chips.
# Limits operations per Metal command buffer.
# See: https://github.com/ml-explore/mlx/issues/1231
MLX_MAX_OPS_PER_BUFFER=1

# ===== MLX MEMORY =====

# MLX buffer cache limit in MB (default 512, prevents swap ballooning).
MLX_CACHE_LIMIT_MB=4096

# Wire GPU memory to prevent page faults during Metal kernel execution.
# Prevents kIOGPUCommandBufferCallbackErrorImpactingInteractivity watchdog.
# Set to ~model size in MB (~20GB for LTX-2 + text encoder).
MLX_WIRED_LIMIT_MB=20480

# ===== EVAL CHUNKING (M2 GPU WATCHDOG MITIGATION) =====

# Smaller chunks avoid Metal GPU watchdog timeouts on cold boot.
LTX_TE_PARAM_EVAL_CHUNK=4
LTX_PARAM_EVAL_CHUNK=6
LTX_EVAL_INTERVAL=8

# Eval each safetensor shard immediately after mx.load() before accumulating.
# Prevents huge Metal command buffers from large model loads.
LTX_TE_SHARD_EVAL_CHUNK=50

# ===== TEXT ENCODER =====

# Max token length for text encoder (default 1024). Shorter = smaller
# attention matrices in the connector (quadratic reduction).
# Must be divisible by 128 (num_learnable_registers).
LTX_TE_MAX_LENGTH=128

# Heads per chunk in ConnectorAttention (30 total). Smaller = shorter
# GPU kernel execution, avoiding watchdog timeout.
LTX_CONNECTOR_HEADS_CHUNK=6

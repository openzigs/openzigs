# LatentSync Lip Sync Sidecar — Environment Variables
# Copy to .env and adjust values as needed.

# Bearer token for authenticating mutating endpoints (required in production)
LIPSYNC_SECRET_TOKEN=

# Model idle timeout in seconds (unloads model after this period of inactivity)
LIPSYNC_MODEL_IDLE_TIMEOUT=300

# Memory limit in GB (MPS only — limits unified memory allocation)
LIPSYNC_MEMORY_LIMIT_GB=24

# HuggingFace token for model downloads
HF_TOKEN=

# Callback secret for webhook POST requests back to the primary server
CALLBACK_SECRET=

# Callback URL for job completion notifications (defaults to http://localhost:3000/api/queue/complete)
# CALLBACK_URL=http://localhost:3000/api/queue/complete

# Progress URL for real-time progress streaming (defaults to http://localhost:3000/api/queue/progress)
# PROGRESS_URL=http://localhost:3000/api/queue/progress

# LatentSync install directory (auto-detected if not set)
# LATENTSYNC_DIR=

# Default model version: v1.5 (256x256, 8GB) or v1.6 (512x512, 18GB)
# LIPSYNC_DEFAULT_MODEL=v1.5

# Port (override via --port CLI flag)
# LIPSYNC_PORT=5008

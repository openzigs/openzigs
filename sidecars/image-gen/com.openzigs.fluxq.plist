<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FluxQ Node — macOS launchd Service Template
  Issue #290: Remote Image Generation (FluxQ Local Network Node)

  Install:
    cp com.openzigs.fluxq.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.openzigs.fluxq.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.openzigs.fluxq.plist
    rm ~/Library/LaunchAgents/com.openzigs.fluxq.plist

  Logs:
    tail -f /tmp/fluxq-stdout.log
    tail -f /tmp/fluxq-stderr.log

  NOTE: Replace __FLUXQ_DIR__ and __USER__ with your actual values,
  or use setup-fluxq-node.sh which does this automatically.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openzigs.fluxq</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__FLUXQ_DIR__/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__FLUXQ_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- All secrets/tokens are loaded from .env by start.sh -->
        <key>PYTORCH_MPS_HIGH_WATERMARK_RATIO</key>
        <string>0.0</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>SessionCreate</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/fluxq-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/fluxq-stderr.log</string>
</dict>
</plist>

# Copilot Auth
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_TOKEN=your_github_token_optional

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_USER_ID=your_telegram_user_id

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token

# Brave Search
BRAVE_API_KEY=your_brave_search_api_key

# Chrome DevTools
CHROME_DEBUG_HOST=localhost
CHROME_DEBUG_PORT=9222
CHROME_AUTO_LAUNCH=true    # set to false to disable auto-launching Chrome

# Filesystem & Shell tool access (comma-separated absolute paths)
OPENZIGS_ALLOWED_DIRS=/Users/you/projects,/tmp

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
OPENZIGS_UI_ORIGIN=http://localhost:3000

{
  "name": "openzigs",
  "version": "0.1.0",
  "description": "Open-source AI assistant and developer tools platform built on GitHub Copilot SDK",
  "type": "module",
  "private": true,
  "license": "FSL-1.1-MIT",
  "author": "Zylos Labs LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openzigs/openzigs.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "openzigs": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup": "tsx src/cli.ts setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.29",
    "@google-cloud/aiplatform": "^6.4.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@huggingface/transformers": "^3.8.1",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@napi-rs/canvas": "^0.1.95",
    "@remotion/bundler": "^4.0.431",
    "@remotion/cli": "^4.0.431",
    "@remotion/renderer": "^4.0.431",
    "@remotion/transitions": "^4.0.431",
    "@types/multer": "^2.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "dockerode": "^4.0.9",
    "docx": "^9.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.40.1",
    "helmet": "^7.2.0",
    "jose": "^6.1.3",
    "mammoth": "^1.11.0",
    "marked": "^17.0.4",
    "multer": "^2.1.1",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "peer": "^1.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.431",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "whisper-node": "^1.1.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.19.13",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "serialize-javascript": ">=7.0.3",
      "undici": ">=7.24.0",
      "esbuild": ">=0.25.0",
      "socket.io-parser": ">=4.2.6",
      "flatted": ">=3.4.2",
      "tar": ">=7.5.11",
      "@github/copilot": "0.0.420",
      "dompurify": ">=3.3.2",
      "@tootallnate/once": ">=3.0.1"
    }
  }
}

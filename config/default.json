{
  "server": {
    "port": 3000
  },
  "logging": {
    "level": "info"
  },
  "auth": {
    "mode": "local",
    "token": "",
    "role": "admin",
    "rateLimit": {
      "windowMs": 60000,
      "max": 10
    }
  },
  "messaging": {
    "accessControl": {
      "mode": "open",
      "allowedUsers": [],
      "blockedUsers": []
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "webhookUrl": "",
      "allowedUsers": [],
      "adminUserId": ""
    },
    "discord": {
      "enabled": false,
      "token": "${DISCORD_BOT_TOKEN}",
      "allowedGuilds": [],
      "adminUsers": []
    },
    "web": {
      "enabled": true
    }
  },
  "tunnel": {
    "enabled": false,
    "mode": "quick",
    "namedTunnel": {
      "credentialsFile": "~/.cloudflared/credentials.json",
      "hostname": "agent.example.com"
    }
  },
  "mcpServers": {
    "autoProvision": true,
    "skipUnconfigured": true,
    "healthRetries": 3,
    "healthRetryDelay": 2000,
    "network": "openzigs-network",
    "sidecars": {}
  },
  "tasks": {
    "maxConcurrent": 2
  },
  "session": {
    "historyWindow": 20,
    "maxToolsPerRequest": 30,
    "dynamicToolLoading": false,
    "infiniteSessions": {
      "enabled": true,
      "backgroundCompactionThreshold": 0.80,
      "bufferExhaustionThreshold": 0.95
    }
  },
  "copilot": {
    "provider": null,
    "defaultReasoningEffort": "medium",
    "defaultWorkingDirectory": null,
    "customAgents": [],
    "nativeMcpServers": {}
  },
  "knowledge": {
    "enabled": true,
    "directory": "",
    "chunkSize": 1000,
    "chunkOverlap": 200,
    "maxResults": 10,
    "includeExtensions": [],
    "excludePatterns": ["node_modules", ".git", "dist", "build", ".DS_Store"],
    "watchEnabled": true,
    "mediaModel": "base.en"
  },
  "voice": {
    "enabled": false,
    "provider": "google",
    "voiceName": "en-US-Standard-C",
    "speakingRate": 1.0,
    "pitch": 0.0,
    "cacheDir": "~/.openzigs/voice-cache",
    "maxCacheSizeMb": 500,
    "maxTextLength": 5000,
    "sidecarUrl": "http://localhost:5006",
    "audio": {
      "ttsEngine": "kokoro",
      "sovitsUrl": "http://127.0.0.1:9880"
    }
  },
  "vault": {
    "enabled": true
  },
  "director": {
    "enabled": true,
    "outputDir": "~/.openzigs/video-output",
    "maxConcurrentRenders": 1,
    "defaultTemplate": "Minimalist",
    "assets": {
      "localLibraryPath": "~/.openzigs/media-library",
      "downloadCachePath": "~/.openzigs/asset-cache",
      "pixabayApiKey": "${PIXABAY_API_KEY}",
      "jamendoClientId": "${JAMENDO_CLIENT_ID}",
      "pexelsApiKey": "${PEXELS_API_KEY}"
    },
    "ingestion": {
      "sceneThreshold": 0.4,
      "keyframeInterval": 5,
      "whisperModel": "base.en"
    },
    "render": {
      "compositionName": "DirectorVideo",
      "timeoutMs": 300000
    }
  },
  "presenter": {
    "inviteSecret": ""
  },
  "imageGen": {
    "mode": "local",
    "networkNodeUrl": "",
    "networkNodeToken": ""
  },
  "videoGen": {
    "mode": "local",
    "networkNodeUrl": "",
    "networkNodeToken": ""
  },
  "musicGen": {
    "mode": "local",
    "networkNodeUrl": "",
    "networkNodeToken": ""
  },
  "socialBrain": {
    "enabled": true,
    "confidenceThreshold": "medium",
    "handoff": {
      "preferredChannel": "discord",
      "autoArchiveMinutes": 60
    },
    "commentAutomation": {
      "enabled": true
    },
    "connections": {
      "instagram": {
        "enabled": false,
        "mode": "webhook",
        "accessToken": "${INSTAGRAM_ACCESS_TOKEN}"
      },
      "facebook": {
        "enabled": false,
        "mode": "webhook",
        "accessToken": "${FACEBOOK_PAGE_ACCESS_TOKEN}"
      },
      "twitter": {
        "enabled": false,
        "mode": "webhook",
        "accessToken": "${TWITTER_BEARER_TOKEN}"
      },
      "youtube": {
        "enabled": false,
        "mode": "polling",
        "pollIntervalSeconds": 300,
        "accessToken": "${YOUTUBE_API_KEY}"
      },
      "linkedin": {
        "enabled": false,
        "mode": "webhook",
        "accessToken": "${LINKEDIN_ACCESS_TOKEN}"
      },
      "reddit": {
        "enabled": false,
        "mode": "polling",
        "pollIntervalSeconds": 120,
        "accessToken": "${REDDIT_CLIENT_ID}"
      }
    }
  },
  "sentinel": {
    "enabled": false,
    "model": "gpt-4o-mini",
    "checkIntervalMinutes": 15,
    "jitterMinutes": 15,
    "slowTaskThresholdMinutes": 5,
    "orphanTaskThresholdMinutes": 30,
    "digestHour": 9,
    "auditHour": 2,
    "consecutiveFailureThreshold": 3,
    "queueDepthThreshold": 10,
    "persistMarkdownDigest": true,
    "markdownDigestPath": null,
    "digestRetentionDays": 30,
    "notifyChannels": ["admin"],
    "criticalCooldownMinutes": 5,
    "warningCooldownMinutes": 30,
    "timezone": "UTC",
    "noOverlap": true,
    "maxRandomDelayMs": 0
  }
}

{
  "server": {
    "port": 3000
  },
  "logging": {
    "level": "info"
  },
  "auth": {
    "mode": "local",
    "token": "",
    "role": "admin",
    "rateLimit": {
      "windowMs": 60000,
      "max": 10
    }
  },
  "messaging": {
    "accessControl": {
      "mode": "open",
      "allowedUsers": [],
      "blockedUsers": []
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowedUsers": []
    },
    "discord": {
      "enabled": false,
      "token": "${DISCORD_BOT_TOKEN}",
      "allowedGuilds": []
    }
  }
}

{
  "server": {
    "port": 3000
  },
  "logging": {
    "level": "info"
  },
  "auth": {
    "mode": "local",
    "token": "",
    "role": "admin",
    "rateLimit": {
      "windowMs": 60000,
      "max": 10
    }
  },
  "messaging": {
    "accessControl": {
      "mode": "open",
      "allowedUsers": [],
      "blockedUsers": []
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "webhookUrl": "",
      "allowedUsers": [],
      "adminUserId": ""
    },
    "discord": {
      "enabled": false,
      "token": "${DISCORD_BOT_TOKEN}",
      "allowedGuilds": [],
      "adminUsers": []
    },
    "web": {
      "enabled": true
    }
  },
  "tunnel": {
    "enabled": false,
    "mode": "quick",
    "namedTunnel": {
      "credentialsFile": "~/.cloudflared/credentials.json",
      "hostname": "agent.example.com"
    }
  },
  "mcpServers": {
    "autoProvision": true,
    "skipUnconfigured": true,
    "healthRetries": 3,
    "healthRetryDelay": 2000,
    "network": "openzigs-network",
    "sidecars": {
      "linkedin": { "enabled": true },
      "twitter": { "enabled": true },
      "facebook": { "enabled": true },
      "pinterest": { "enabled": true },
      "word": { "enabled": true }
    }
  }
}

{
  "server": {
    "port": 3000
  },
  "logging": {
    "level": "info"
  },
  "auth": {
    "mode": "local",
    "token": "",
    "role": "admin",
    "rateLimit": {
      "windowMs": 60000,
      "max": 10
    }
  },
  "messaging": {
    "accessControl": {
      "mode": "open",
      "allowedUsers": [],
      "blockedUsers": []
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "webhookUrl": "",
      "allowedUsers": [],
      "adminUserId": ""
    },
    "discord": {
      "enabled": false,
      "token": "${DISCORD_BOT_TOKEN}",
      "allowedGuilds": [],
      "adminUsers": []
    },
    "web": {
      "enabled": true
    }
  },
  "tunnel": {
    "enabled": false,
    "mode": "quick",
    "namedTunnel": {
      "credentialsFile": "~/.cloudflared/credentials.json",
      "hostname": "agent.example.com"
    }
  },
  "mcpServers": {
    "autoProvision": true,
    "skipUnconfigured": true,
    "healthRetries": 3,
    "healthRetryDelay": 2000,
    "network": "openzigs-network",
    "sidecars": {
      "linkedin": { "enabled": true, "disabledTools": [] },
      "twitter": { "enabled": true, "disabledTools": [] },
      "facebook": { "enabled": true, "disabledTools": [] },
      "pinterest": { "enabled": true, "disabledTools": [] },
      "word": { "enabled": true, "disabledTools": [] },
      "markitdown": {
        "enabled": true,
        "disabledTools": [],
        "runtime": "docker",
        "image": "markitdown-mcp:latest",
        "port": 5301,
        "volumes": ["/data:/workdir"]
      },
      "gmail": {
        "enabled": true,
        "disabledTools": [],
        "runtime": "docker",
        "image": "mcp/gmail:latest",
        "port": 5302,
        "env": {
          "GMAIL_OAUTH_PATH": "/gcp-oauth.keys.json",
          "GMAIL_CREDENTIALS_PATH": "/gmail-server/credentials.json"
        }
      },
      "database": {
        "enabled": true,
        "disabledTools": [],
        "runtime": "jbang",
        "command": "jbang",
        "args": ["jdbc@quarkiverse/quarkus-mcp-servers", "${JDBC_URL}"],
        "port": 5303,
        "env": {
          "JDBC_URL": "${JDBC_URL}"
        }
      },
      "github": {
        "enabled": true,
        "disabledTools": [],
        "runtime": "docker",
        "image": "ghcr.io/github/github-mcp-server:latest",
        "port": 5304,
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  },
  "tasks": {
    "maxConcurrent": 2
  },
  "session": {
    "historyWindow": 20,
    "maxToolsPerRequest": 30,
    "dynamicToolLoading": false,
    "infiniteSessions": {
      "enabled": true,
      "backgroundCompactionThreshold": 0.80,
      "bufferExhaustionThreshold": 0.95
    }
  },
  "copilot": {
    "provider": null,
    "defaultReasoningEffort": "medium",
    "defaultWorkingDirectory": null,
    "customAgents": [],
    "nativeMcpServers": {}
  },
  "knowledge": {
    "enabled": true,
    "directory": "",
    "chunkSize": 1000,
    "chunkOverlap": 200,
    "maxResults": 10,
    "includeExtensions": [],
    "excludePatterns": ["node_modules", ".git", "dist", "build", ".DS_Store"],
    "watchEnabled": true,
    "mediaModel": "base.en"
  },
  "voice": {
    "enabled": false,
    "provider": "google",
    "voiceName": "en-US-Standard-C",
    "speakingRate": 1.0,
    "pitch": 0.0,
    "cacheDir": "~/.openzigs/voice-cache",
    "maxCacheSizeMb": 500,
    "maxTextLength": 5000
  },
  "sentinel": {
    "enabled": false,
    "model": "gpt-4o-mini",
    "checkIntervalMinutes": 15,
    "jitterMinutes": 15,
    "slowTaskThresholdMinutes": 5,
    "orphanTaskThresholdMinutes": 30,
    "digestHour": 9,
    "auditHour": 2,
    "consecutiveFailureThreshold": 3,
    "queueDepthThreshold": 10,
    "persistMarkdownDigest": true,
    "markdownDigestPath": null,
    "digestRetentionDays": 30,
    "notifyChannels": ["admin"],
    "criticalCooldownMinutes": 5,
    "warningCooldownMinutes": 30,
    "timezone": "UTC",
    "noOverlap": true,
    "maxRandomDelayMs": 0
  }
}

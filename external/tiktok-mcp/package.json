      "mcpb:pack": "mcpb pack"
    },
    "dependencies": {
      "@modelcontextprotocol/sdk": "1.10.1"
    },
    "devDependencies": {
      "@types/node": "^22",
      "shx": "^0.3.4",
      "typescript": "^5.6.2"
    }
  }
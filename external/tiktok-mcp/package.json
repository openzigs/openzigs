{
    "name": "tiktok-mcp",
    "version": "1.0.0",
    "description": "MCP server for TikTok — Official TikTok API v2 (Content Posting, Display, OAuth)",
    "license": "MIT",
    "author": "OpenZigs",
    "homepage": "https://developers.tiktok.com",
    "type": "module",
    "bin": {
      "tiktok-mcp-server": "build/index.js"
